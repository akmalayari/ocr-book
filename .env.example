# Copy this file to .env and fill in your own paths.
# .env is gitignored and will NOT be committed.

OCR_LLAMA_SERVER_PATH=C:/path/to/llama-server.exe
OCR_MODEL_PATH=C:/path/to/PaddleOCR-VL-1.5.gguf
OCR_MMPROJ_PATH=C:/path/to/PaddleOCR-VL-1.5-mmproj.gguf

# Optional: only needed for Obsidian mode
OCR_OBSIDIAN_VAULT_ROOT=C:/path/to/Obsidian/Vault

# ── Optional: hardware tuning ────────────────────────────────────────────────
# The defaults in src/config.py are conservative so the pipeline runs anywhere.
# Uncomment and adjust to exploit your own machine. CLI flags override these.
#
# OCR_N_PARALLEL=3        # intra-page slots; >1 REQUIRES apply_paddlex_patch_parallel.py
# OCR_N_CTX=12288         # total KV cache; per-slot budget = OCR_N_CTX / OCR_N_PARALLEL
# OCR_N_THREADS=16        # CPU threads for llama-server
# OCR_N_SERVERS=1         # parallel servers; >1 is useless on a single GPU/APU
# OCR_N_BATCH=512
# OCR_N_UBATCH=512
# OCR_N_GPU_LAYERS=99
# OCR_MAX_TOKENS=4096     # max tokens generated per page
# OCR_KV_OFFLOAD=true     # false to keep the KV cache off the GPU
# OCR_PAGE_TIMEOUT=120    # seconds per page before giving up (0 = disabled)
# OCR_SERVER_TIMEOUT=60   # seconds to wait for llama-server startup
# OCR_SERVER_BASE_PORT=8080

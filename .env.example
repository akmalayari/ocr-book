# Copy this file to .env and fill in your own paths.
# .env is gitignored and will NOT be committed.

# Required unless setup.py built llama-server. Examples:
# Linux:  /absolute/path/to/llama-server
# Windows: C:/absolute/path/to/llama-server.exe
OCR_LLAMA_SERVER_PATH=

# setup.py downloads both model files to the user cache and records their paths
# in .env. Leave these empty to use automatically discovered cached files.
OCR_MODEL_PATH=
OCR_MMPROJ_PATH=
# Optional cache override, used by setup.py and automatic discovery:
# OCR_MODEL_CACHE_DIR=/absolute/path/to/model-cache

# Optional: only needed for Obsidian mode
# Linux:  OCR_OBSIDIAN_VAULT_ROOT=/absolute/path/to/Obsidian/Vault
# Windows: OCR_OBSIDIAN_VAULT_ROOT=C:/absolute/path/to/Obsidian/Vault
OCR_OBSIDIAN_VAULT_ROOT=

# ── Optional: hardware tuning ────────────────────────────────────────────────
# Everything below is UNSET by default: llama-server auto-fits those arguments
# to the available device memory (--fit on), which usually beats a hardcoded
# value. Only set one when you have measured that it helps on your machine.
# CLI flags override these.
#
# OCR_N_PARALLEL=2        # default: 1; test 2 first
#                         # 3+ is hardware-dependent and must be validated
# OCR_N_CTX=4096          # total KV cache for 2 slots; increase for dense tables
#                         # (default: n_parallel * 2048)
# OCR_N_THREADS=4        # llama-server default: -1 (auto)
# OCR_N_BATCH=2048        # llama-server default: 2048
# OCR_N_UBATCH=512        # llama-server default: 512
# OCR_N_GPU_LAYERS=99     # llama-server default: auto
# OCR_KV_OFFLOAD=false    # llama-server default: enabled
# OCR_PRIO=2              # process priority 0-3; llama-server default: 0
#
# Pipeline-side (always applied, not passed to llama-server):
# OCR_N_SERVERS=1         # parallel servers; >1 is useless on a single GPU/APU
# OCR_MAX_TOKENS=4096     # max tokens generated per page
# OCR_PAGE_TIMEOUT=120    # seconds per page before giving up (0 = disabled)
# OCR_SERVER_TIMEOUT=60   # seconds to wait for llama-server startup
# OCR_SERVER_BASE_PORT=8080
